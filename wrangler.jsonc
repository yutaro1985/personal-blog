{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-blog-local-poc",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-blog-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "remote": false,
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "personal-blog-local-media",
      "remote": false,
    },
  ],
}
