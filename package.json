{
  "name": "personal-blog-migration-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.private/logs astro dev --host 127.0.0.1",
    "build": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.private/logs astro build",
    "check": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.private/logs astro check",
    "test": "node --test tests/*.test.mjs",
    "test:http": "node scripts/smoke.mjs",
    "inventory": "node scripts/inventory.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:local": "node scripts/seed-local.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "7.0.1",
    "@emdash-cms/cloudflare": "1.2.0",
    "astro": "7.3.8",
    "emdash": "1.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sax": "1.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3",
    "wrangler": "4.149.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "0.14.1",
    "@emdash-cms/gutenberg-to-portable-text": "1.2.0"
  },
  "packageManager": "npm@11.19.0"
}
